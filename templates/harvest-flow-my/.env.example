# Personal instance defaults (edit before running)
APP_METADATA_DB_CLIENT=sqlite
APP_METADATA_DB=pipeline_metadata.db
APP_VECTOR_DB_CLIENT=qdrant
APP_VECTOR_DB_DIR=qdrant_local
APP_QDRANT_COLLECTION=harvest_notes

APP_LOG_STEM=logs
APP_PUBLISH_CONTENT_STEM=quartz_content
APP_VAULT_STEM=/ABSOLUTE/PATH/TO/YOUR/OBSIDIAN/VAULT
NOTES_APP_NAME=obsidian

OLLAMA_EMBED_URL=http://localhost:11434/api/embeddings
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_GENERATE_URL=http://localhost:11434/api/generate
OLLAMA_PIPELINE_MODEL=gemma2:2b
OLLAMA_RAG_MODEL=gemma2:2b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_PIPELINE_NUM_PREDICT=160
OLLAMA_RAG_NUM_PREDICT=256
OLLAMA_PIPELINE_BODY_MAX_CHARS=2500
OLLAMA_RAG_BODY_MAX_CHARS=800

APP_PUBLISH_CLIENT=github
GIT_BRANCH=main
GIT_PUSH=1
APP_STARTUP_SYNC=1
APP_PUBLISH_DELAY_MINUTES=10
APP_DELETE_DELAY_MINUTES=60
APP_CACHE_SIM_THRESHOLD=0.93
APP_CACHE_RECENT_LIMIT=20

APP_WORKFLOW_DRAFT_DIR=1_초안
APP_WORKFLOW_REVIEW_REQUEST_DIR=2_검수요청
APP_WORKFLOW_PUBLISH_WAIT_DIR=3_출간대기
APP_WORKFLOW_NEEDS_FIX_DIR=4_수정필요
APP_WORKFLOW_SECOND_REVIEW_DONE_DIR=5_2차검수완료
APP_WORKFLOW_PUBLISHED_DIR=6_출간완료
APP_WORKFLOW_REVISE_WAIT_DIR=7_수정대기
APP_WORKFLOW_DELETE_REQUEST_DIR=8_삭제요청
APP_WORKFLOW_TRASH_DIR=9_휴지통

